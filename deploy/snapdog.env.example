SNAPDOG_IMAGE=ghcr.io/snapdogrocks/snapdog:latest
UPDATER_IMAGE=ghcr.io/snapdogrocks/snapdog-updater:latest

# Generate with: openssl rand -hex 32
UPDATER_TOKEN=replace-with-openssl-rand-hex-32

AUTO_APPLY=true
AUTO_UPDATE_UPDATER=true
MAINTENANCE_TIME=02:00
TZ=Europe/Berlin

# Optional: raises the unauthenticated GitHub API rate limit.
# GITHUB_TOKEN=github_pat_read_only
