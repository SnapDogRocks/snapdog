# ── Stage 1: Build the Web UI ──
FROM node:25-slim AS frontend-builder
WORKDIR /app/webui
# Pinned to the same version as webui/package.json's "packageManager" field.
# Installed via plain npm, not corepack — Node 25 dropped corepack from the
# distribution, and this stage's base image is node:25-slim.
RUN npm install -g pnpm@12.3.4
COPY webui/package.json webui/pnpm-lock.yaml webui/pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile
COPY webui/ ./
RUN pnpm run build

# ── Stage 2: Create runtime container ──
FROM node:25-slim
WORKDIR /app

# Install production dependencies for the mock backend
COPY demo-backend/package.json demo-backend/package-lock.json* ./
RUN npm install --production

# Copy static Web UI build from Stage 1
COPY --from=frontend-builder /app/webui/out ./public

# Copy mock server code
COPY demo-backend/ ./

# Mirror the real server's version instead of drifting from it: the workspace
# Cargo.toml is the same source env!("CARGO_PKG_VERSION") reads at Rust compile
# time. Bake just the version string in, not the whole file.
COPY Cargo.toml /tmp/workspace-cargo.toml
RUN awk '/^\[workspace.package\]/{f=1; next} /^\[/{f=0} f && /^version/{print}' /tmp/workspace-cargo.toml \
      | sed -E 's/version = "(.*)"/\1/' > VERSION \
    && rm /tmp/workspace-cargo.toml

EXPOSE 5555
ENV PORT=5555
ENV NODE_ENV=production

CMD ["node", "server.js"]
