# Same Node line and digest as Dockerfile, webui/.nvmrc and ci.yml.
ARG NODE_IMAGE="node:24-bookworm-slim@sha256:cb4e8f7c443347358b7875e717c29e27bf9befc8f5a26cf18af3c3dec80e58c5"
# The demo's equalizer has at most this many bands. Both the web UI build and the mock
# backend read it from here; the real server allows SERVER_EQ_LIMITS.maxBands.
ARG DEMO_MAX_EQ_BANDS=5

# ── Stage 1: Build the Web UI ──
FROM ${NODE_IMAGE} AS frontend-builder
ARG DEMO_MAX_EQ_BANDS
WORKDIR /app/webui
# Pinned to the same version as webui/package.json's "packageManager" field.
# Installed via plain npm, not corepack, so the version does not depend on the
# corepack shipped with the base image.
RUN npm install -g pnpm@11.28.8
COPY webui/package.json webui/pnpm-lock.yaml webui/pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile
ENV NEXT_PUBLIC_MAX_EQ_BANDS=${DEMO_MAX_EQ_BANDS}
COPY webui/ ./
RUN pnpm run build

# ── Stage 2: Create runtime container ──
FROM ${NODE_IMAGE}
ARG DEMO_MAX_EQ_BANDS
ENV DEMO_MAX_EQ_BANDS=${DEMO_MAX_EQ_BANDS}
WORKDIR /app

# Install production dependencies for the mock backend, exactly as locked, with
# the pnpm from demo-backend/package.json's "packageManager".
RUN npm install -g pnpm@11.28.8
COPY demo-backend/package.json demo-backend/pnpm-lock.yaml ./
RUN pnpm install --prod --frozen-lockfile

# Copy static Web UI build from Stage 1
COPY --from=frontend-builder /app/webui/out ./public
# The demo shows the current Web UI only, so the legacy entry is not shipped.
RUN rm -rf ./public/legacy ./public/legacy.html ./public/legacy.txt

# Copy mock server code
COPY demo-backend/ ./

# Mirror the real server's version instead of drifting from it: the workspace
# Cargo.toml is the same source env!("CARGO_PKG_VERSION") reads at Rust compile
# time. Bake just the version string in, not the whole file.
COPY Cargo.toml /tmp/workspace-cargo.toml
RUN awk '/^\[workspace.package\]/{f=1; next} /^\[/{f=0} f && /^version/{print}' /tmp/workspace-cargo.toml \
      | sed -E 's/version = "(.*)"/\1/' > VERSION \
    && rm /tmp/workspace-cargo.toml

EXPOSE 5555
ENV PORT=5555
ENV NODE_ENV=production

# The mock server only reads its files; it needs no root.
USER node
CMD ["node", "server.js"]
